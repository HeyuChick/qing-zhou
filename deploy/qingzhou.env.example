# /opt/qingzhou/qingzhou.env  —  chmod 600, never commit the real file.

# --- Core ---
QZ_LISTEN=127.0.0.1:8081
# SQLite 路径。变量名是 QZ_DB（不是 QZ_DB_PATH）；相对路径基于工作目录。
QZ_DB=/opt/qingzhou/qingzhou.db

# 面板对外访问地址（订阅链接、探针安装、邮件链接、sing-box 安装命令都用它）。
# 可选：也能在「系统设置 → 面板访问地址」里填。优先级：本环境变量 > 设置页 > 反代头/Host。
# 设了本变量就以它为准，且设置页对应字段会变为只读。
QZ_PUBLIC_BASE=https://node.example.com

# Serve the new Vue 3 frontend (includes the 在线更新 admin page).
QZ_USE_NEW_FRONTEND=1

# --- 探针监控（可选）---
# 探针二进制所在目录，面板据此提供 /api/monitor/agent/linux-<arch> 下载。
# 默认相对路径 cmd/probe/dist —— 二进制部署时该目录通常不存在，探针安装会 404。
# 需从 GitHub Release 下载 probe-linux-amd64 / probe-linux-arm64 放入此目录（文件名不变）。
# QZ_PROBE_DIR=/opt/qingzhou/probe

# --- 在线更新（可选）---
# 面板「在线更新」页检查此仓库的 GitHub Releases。默认 mllt992/qing-zhou。
# QZ_UPDATE_REPO=mllt992/qing-zhou
# GitHub token（可选）：仅用于提升匿名 API 速率上限（60/时），公开仓库无需权限。
# QZ_UPDATE_GITHUB_TOKEN=

# First-run admin (only used to seed; change password after first login).
# If QZ_ADMIN_PASS is empty, a random password is generated and logged once.
QZ_ADMIN_USER=admin
QZ_ADMIN_PASS=

# Master key for encrypting secret settings (SMTP password) at rest.
# Keep this OUTSIDE the database. Generate with: openssl rand -hex 32
QZ_SECRET_KEY=

# --- SMTP (optional; if unset, verify/reset links are logged instead) ---
# QZ_SMTP_HOST=smtp.example.com
# QZ_SMTP_PORT=587
# QZ_SMTP_USER=
# QZ_SMTP_PASS=
# QZ_SMTP_FROM=
# QZ_SMTP_SECURITY=starttls
